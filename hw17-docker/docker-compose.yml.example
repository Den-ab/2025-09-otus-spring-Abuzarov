services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: hw17-app-container
    ports:
      - "8080:8080"
    networks:
      - otus-net
    environment:
      SPRING_DATASOURCE_URL: jdbc:h2:mem:maindb;DB_CLOSE_DELAY=-1
      SPRING_DATASOURCE_USERNAME: sa
      SPRING_DATASOURCE_PASSWORD:
      SPRING_SQL_INIT_MODE: always

  prometheus:
    image: prom/prometheus:latest
    container_name: hw17-prometheus
    ports:
      - "9090:9090"
    volumes:
      - ./prometheus.yml:/etc/prometheus/prometheus.yml
    depends_on:
      - app
    networks:
      - otus-net
networks:
  otus-net:
    driver: bridge
